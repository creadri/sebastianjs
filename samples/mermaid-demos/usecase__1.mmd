usecase-beta
direction LR
        actor User1("Customer")
        actor User2("Account owner")
        actor User3("Analyst")
        actor User4("Auditor")
        actor Admin1("Module A administrator")
        actor Admin2("Module B administrator")
        actor NotificationService("Notification service")@{ icon: "fa:bell" }
        actor DataService("Data service")@{ icon: "fa:database" }

        systemBoundary "Module A"
          FeatureA1("Feature A1")
          FeatureA2("Feature A2")
          AdminA1("Admin A1")
        end
        Module_A@{ type: package }

        systemBoundary "Module B"
          FeatureB1("Feature B1")
          FeatureB2("Feature B2")
          AdminB1("Admin B1")
        end

        User1 -- "important" --> FeatureA1
        User2 --> FeatureA2
        Admin1 --> AdminA1
        User3 --> FeatureB1
        User4 --> FeatureB2
        Admin2 --> AdminB1

        FeatureA1 --> NotificationService
        FeatureB1 --> NotificationService
        AdminA1 --> DataService
        AdminB1 --> DataService

        User1 -- "collaborates" --> User2
        Admin1 -- "supervises" --> Admin2